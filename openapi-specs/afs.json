{
  "info": {
    "description": "Proof-of-concept facade with an asynchronous, polled query lifecycle.\nRoutes follow the AGS admin-endpoint convention: {SERVER_BASE_PATH}/v1/admin/namespaces/{namespace}/...\nThe MCP server is the only intended client and is responsible for the poll loop.",
    "title": "Athena Facade POC",
    "version": "0.4.0"
  },
  "schemes": [
    "https"
  ],
  "securityDefinitions": {
    "bearerAuth": {
      "description": "AccelByte IAM JWT (RS256) validated against AB IAM's JWKS via the IAM Go SDK.",
      "in": "header",
      "name": "Authorization",
      "type": "apiKey"
    }
  },
  "swagger": "2.0",
  "paths": {
    "/afs/v1/admin/namespaces/{namespace}/context": {
      "get": {
        "description": "Returns Markdown by default; pass format=json for a JSON-wrapped response.",
        "operationId": "AdminGetContext",
        "parameters": [
          {
            "description": "Target namespace.",
            "in": "path",
            "name": "namespace",
            "required": true,
            "type": "string"
          },
          {
            "description": "Set to json to get a JSON-wrapped response.",
            "enum": [
              "json"
            ],
            "in": "query",
            "name": "format",
            "type": "string"
          },
          {
            "description": "ETag from a previous response; returns 304 if unchanged.",
            "in": "header",
            "name": "If-None-Match",
            "type": "string"
          }
        ],
        "produces": [
          "application/json",
          "text/markdown"
        ],
        "responses": {
          "200": {
            "description": "Context document (Content-Type: text/markdown or application/json).",
            "schema": {
              "type": "object"
            }
          },
          "304": {
            "description": "Not Modified."
          },
          "401": {
            "description": "Missing or invalid AB IAM JWT.",
            "schema": {
              "$ref": "#/definitions/handler.errorBody"
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Return the AGS API Events context document",
        "tags": [
          "context"
        ],
        "x-errorCodes": {},
        "x-security": [
          {
            "iamClientScopes": [
              "analytics"
            ]
          },
          {
            "userPermissions": [
              "ADMIN:NAMESPACE:{namespace}:ANALYTICS:QUERY [READ]"
            ]
          }
        ]
      }
    },
    "/afs/v1/admin/namespaces/{namespace}/queries": {
      "post": {
        "consumes": [
          "application/json"
        ],
        "description": "Returns 202 with query_id, or 200 with rows inline if the query terminates within the fast-path window.",
        "operationId": "AdminSubmitQuery",
        "parameters": [
          {
            "description": "Target namespace. Caller must have ADMIN:NAMESPACE:{namespace}:ANALYTICS:QUERY permission.",
            "in": "path",
            "name": "namespace",
            "required": true,
            "type": "string"
          },
          {
            "description": "Optional client-supplied idempotency key used as Athena ClientRequestToken.",
            "in": "header",
            "name": "Idempotency-Key",
            "type": "string"
          },
          {
            "description": "Query request",
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/handler.submitRequest"
            }
          }
        ],
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "Fast-path success: query reached a terminal state within wait_ms.",
            "schema": {
              "$ref": "#/definitions/handler.fetchResponse"
            }
          },
          "202": {
            "description": "Query submitted; poll GET .../queries/{id} for status.",
            "schema": {
              "$ref": "#/definitions/handler.submitAccepted"
            }
          },
          "400": {
            "description": "Bad request (invalid SQL, unknown database, malformed body, missing partition predicate).",
            "schema": {
              "$ref": "#/definitions/handler.errorBody"
            }
          },
          "401": {
            "description": "Missing or invalid AB IAM JWT.",
            "schema": {
              "$ref": "#/definitions/handler.errorBody"
            }
          },
          "403": {
            "description": "JWT valid but lacks the required permission, or invalid namespace.",
            "schema": {
              "$ref": "#/definitions/handler.errorBody"
            }
          },
          "413": {
            "description": "SQL body exceeds the configured MAX_SQL_BYTES limit.",
            "schema": {
              "$ref": "#/definitions/handler.errorBody"
            }
          },
          "500": {
            "description": "Unexpected error.",
            "schema": {
              "$ref": "#/definitions/handler.errorBody"
            }
          },
          "503": {
            "description": "Transient tenancy provisioning failure; retry.",
            "schema": {
              "$ref": "#/definitions/handler.errorBody"
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Submit an Athena SQL query (async)",
        "tags": [
          "queries"
        ],
        "x-errorCodes": {},
        "x-security": [
          {
            "iamClientScopes": [
              "analytics"
            ]
          },
          {
            "userPermissions": [
              "ADMIN:NAMESPACE:{namespace}:ANALYTICS:QUERY [READ]"
            ]
          }
        ]
      }
    },
    "/afs/v1/admin/namespaces/{namespace}/queries/{id}": {
      "delete": {
        "operationId": "AdminCancelQuery",
        "parameters": [
          {
            "description": "Target namespace.",
            "in": "path",
            "name": "namespace",
            "required": true,
            "type": "string"
          },
          {
            "description": "The query_id to cancel.",
            "in": "path",
            "name": "id",
            "required": true,
            "type": "string"
          }
        ],
        "produces": [
          "application/json"
        ],
        "responses": {
          "204": {
            "description": "Cancellation issued, or query already terminal."
          },
          "401": {
            "description": "Missing or invalid AB IAM JWT.",
            "schema": {
              "$ref": "#/definitions/handler.errorBody"
            }
          },
          "403": {
            "description": "JWT valid but lacks permission, or caller is not the submitting tenant.",
            "schema": {
              "$ref": "#/definitions/handler.errorBody"
            }
          },
          "404": {
            "description": "Unknown query_id.",
            "schema": {
              "$ref": "#/definitions/handler.errorBody"
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Cancel an in-flight query (idempotent)",
        "tags": [
          "queries"
        ],
        "x-errorCodes": {},
        "x-security": [
          {
            "iamClientScopes": [
              "analytics"
            ]
          },
          {
            "userPermissions": [
              "ADMIN:NAMESPACE:{namespace}:ANALYTICS:QUERY [READ]"
            ]
          }
        ]
      },
      "get": {
        "operationId": "AdminFetchQuery",
        "parameters": [
          {
            "description": "Target namespace.",
            "in": "path",
            "name": "namespace",
            "required": true,
            "type": "string"
          },
          {
            "description": "The query_id returned by POST .../queries.",
            "in": "path",
            "name": "id",
            "required": true,
            "type": "string"
          },
          {
            "description": "Max rows to return (1–10000, default 1000).",
            "in": "query",
            "name": "max_rows",
            "type": "integer"
          },
          {
            "description": "Opaque continuation token from a previous response's next_page_token.",
            "in": "query",
            "name": "page_token",
            "type": "string"
          }
        ],
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "Current state of the query. May still be RUNNING.",
            "schema": {
              "$ref": "#/definitions/handler.fetchResponse"
            }
          },
          "401": {
            "description": "Missing or invalid AB IAM JWT.",
            "schema": {
              "$ref": "#/definitions/handler.errorBody"
            }
          },
          "403": {
            "description": "JWT valid but lacks permission, or caller is not the submitting tenant.",
            "schema": {
              "$ref": "#/definitions/handler.errorBody"
            }
          },
          "404": {
            "description": "Unknown or aged-out query_id.",
            "schema": {
              "$ref": "#/definitions/handler.errorBody"
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Fetch query status and (if terminal) result rows",
        "tags": [
          "queries"
        ],
        "x-errorCodes": {},
        "x-security": [
          {
            "iamClientScopes": [
              "analytics"
            ]
          },
          {
            "userPermissions": [
              "ADMIN:NAMESPACE:{namespace}:ANALYTICS:QUERY [READ]"
            ]
          }
        ]
      }
    },
    "/afs/v1/admin/namespaces/{namespace}/tables": {
      "get": {
        "operationId": "AdminSearchTables",
        "parameters": [
          {
            "description": "Target namespace.",
            "in": "path",
            "name": "namespace",
            "required": true,
            "type": "string"
          },
          {
            "description": "Allowed database name.",
            "in": "query",
            "name": "database",
            "required": true,
            "type": "string"
          },
          {
            "description": "Case-insensitive substring filter on table name.",
            "in": "query",
            "name": "query",
            "type": "string"
          },
          {
            "description": "Pagination offset (default 0).",
            "in": "query",
            "name": "offset",
            "type": "integer"
          },
          {
            "description": "Page size (1–100, default 20).",
            "in": "query",
            "name": "limit",
            "type": "integer"
          }
        ],
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "Paginated list of table summaries.",
            "schema": {
              "type": "object"
            }
          },
          "400": {
            "description": "Bad request (missing database, invalid pagination, disallowed database).",
            "schema": {
              "$ref": "#/definitions/handler.errorBody"
            }
          },
          "401": {
            "description": "Missing or invalid AB IAM JWT.",
            "schema": {
              "$ref": "#/definitions/handler.errorBody"
            }
          },
          "500": {
            "description": "Unexpected error.",
            "schema": {
              "$ref": "#/definitions/handler.errorBody"
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "List or search tables in a database",
        "tags": [
          "tables"
        ],
        "x-errorCodes": {},
        "x-security": [
          {
            "iamClientScopes": [
              "analytics"
            ]
          },
          {
            "userPermissions": [
              "ADMIN:NAMESPACE:{namespace}:ANALYTICS:QUERY [READ]"
            ]
          }
        ]
      }
    },
    "/afs/v1/admin/namespaces/{namespace}/tables/{database}/{table}": {
      "get": {
        "operationId": "AdminDescribeTable",
        "parameters": [
          {
            "description": "Target namespace.",
            "in": "path",
            "name": "namespace",
            "required": true,
            "type": "string"
          },
          {
            "description": "Allowed database name.",
            "in": "path",
            "name": "database",
            "required": true,
            "type": "string"
          },
          {
            "description": "Table name.",
            "in": "path",
            "name": "table",
            "required": true,
            "type": "string"
          }
        ],
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "Full table metadata.",
            "schema": {
              "$ref": "#/definitions/glue.TableSummary"
            }
          },
          "400": {
            "description": "Database not in allowed list.",
            "schema": {
              "$ref": "#/definitions/handler.errorBody"
            }
          },
          "401": {
            "description": "Missing or invalid AB IAM JWT.",
            "schema": {
              "$ref": "#/definitions/handler.errorBody"
            }
          },
          "404": {
            "description": "Table not found.",
            "schema": {
              "$ref": "#/definitions/handler.errorBody"
            }
          },
          "500": {
            "description": "Unexpected error.",
            "schema": {
              "$ref": "#/definitions/handler.errorBody"
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Describe a single table",
        "tags": [
          "tables"
        ],
        "x-errorCodes": {},
        "x-security": [
          {
            "iamClientScopes": [
              "analytics"
            ]
          },
          {
            "userPermissions": [
              "ADMIN:NAMESPACE:{namespace}:ANALYTICS:QUERY [READ]"
            ]
          }
        ]
      }
    }
  },
