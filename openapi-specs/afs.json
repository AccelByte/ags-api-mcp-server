    "handler.contextCreateBody": {
      "description": "Request body for creating a new user-authored analytics context.",
      "properties": {
        "body": {
          "description": "Markdown body of this context section.",
          "type": "string"
        },
        "kind": {
          "description": "Context kind. `custom_table` for tenant-specific table schemas; `ags_extension` for additive overlays on AGS event tables.",
          "enum": [
            "ags_extension",
            "custom_table"
          ],
          "type": "string"
        },
        "name": {
          "description": "Unique name within the tenant. Pattern: ^[a-z][a-z0-9_]{0,63}$.",
          "type": "string"
        },
        "order": {
          "default": 100,
          "description": "Signed 32-bit integer controlling where this context merges relative to the base context in `GET /context`. The base context is conceptually at `order = 0` with a sentinel `created_at` predating any user-authored content. Lower values merge earlier; ties are broken by `created_at` ascending. Use **negative** values (e.g. `-10`) for context that should precede the base — useful for narrative framing, schema-wide caveats, or anything the LLM should read before the AGS event schema. Use **positive** values (e.g. `10`, `100`) for context that should follow the base — typical for additive overlays on specific tables or custom-telemetry schema descriptions. A user-authored context at `order = 0` merges immediately **after** the base because the base's sentinel `created_at` wins the tie-break. Defaults to `100` when omitted on `POST`.",
          "format": "int32",
          "type": "integer"
        },
        "table_refs": {
          "description": "For `ags_extension`: required list of `<database>.<table>` references this context covers. For `custom_table`: optional, uninterpreted.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "body",
        "kind",
        "name"
      ],
      "type": "object"
    },
