{
  "info": {
    "description": "Proof-of-concept facade with an asynchronous, polled query lifecycle.\nRoutes follow the AGS admin-endpoint convention: {SERVER_BASE_PATH}/v1/admin/namespaces/{namespace}/...\nThe MCP server is the only intended client and is responsible for the poll loop.",
    "title": "Athena Facade POC",
    "version": "0.4.0"
  },
  "schemes": [
    "https"
  ],
  "securityDefinitions": {
    "bearerAuth": {
      "description": "AccelByte IAM JWT (RS256) validated against AB IAM's JWKS via the IAM Go SDK.",
      "in": "header",
      "name": "Authorization",
      "type": "apiKey"
    }
  },
  "swagger": "2.0",
  "paths": {
    "/afs/v1/admin/namespaces/{namespace}/context": {
      "get": {
        "description": "Returns the merged analytics context document. The response interleaves the embedded base context with every user-authored context the tenant has created (via `POST /contexts`), sorted by `(order ASC, created_at ASC)`. The base context participates in the sort at `order = 0` with a sentinel `created_at` predating any user-authored content, so user contexts with negative `order` merge before the base and positive `order` after it. Returns Markdown by default; pass `format=json` for a JSON-wrapped response with an `X-Context-Version` ETag header.",
        "operationId": "AdminGetContext",
        "parameters": [
          {
            "description": "Target namespace.",
            "in": "path",
            "name": "namespace",
            "required": true,
            "type": "string"
          },
          {
            "description": "Set to json to get a JSON-wrapped response.",
            "enum": [
              "json"
            ],
            "in": "query",
            "name": "format",
            "type": "string"
          },
          {
            "description": "ETag from a previous response; returns 304 if unchanged.",
            "in": "header",
            "name": "If-None-Match",
            "type": "string"
          }
        ],
        "produces": [
          "application/json",
          "text/markdown"
        ],
        "responses": {
          "200": {
            "description": "Context document (Content-Type: text/markdown or application/json).",
            "schema": {
              "type": "object"
            }
          },
          "304": {
            "description": "Not Modified."
          },
          "401": {
            "description": "Missing or invalid AB IAM JWT.",
            "schema": {
              "$ref": "#/definitions/handler.errorBody"
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Return the AGS API Events context document",
        "tags": [
          "context"
        ],
        "x-errorCodes": {},
        "x-security": [
          {
            "iamClientScopes": [
              "analytics"
            ]
          },
          {
            "userPermissions": [
              "ADMIN:NAMESPACE:{namespace}:ANALYTICS:QUERY [READ]"
            ]
          }
        ]
      }
    },
    "/afs/v1/admin/namespaces/{namespace}/contexts": {
      "get": {
        "description": "Lists tenant-owned contexts. `body` is omitted from list responses to keep payloads small.",
        "operationId": "AdminListContexts",
        "parameters": [
          {
            "description": "Target namespace.",
            "in": "path",
            "name": "namespace",
            "required": true,
            "type": "string"
          },
          {
            "default": 0,
            "description": "Pagination offset (default 0).",
            "in": "query",
            "name": "offset",
            "type": "integer"
          },
          {
            "default": 20,
            "description": "Page size (default 20, max 100).",
            "in": "query",
            "maximum": 100,
            "name": "limit",
            "type": "integer"
          },
          {
            "description": "Filter by kind.",
            "enum": [
              "ags_extension",
              "custom_table"
            ],
            "in": "query",
            "name": "kind",
            "type": "string"
          }
        ],
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "Paginated list of contexts.",
            "schema": {
              "$ref": "#/definitions/handler.contextListResponse"
            }
          },
          "401": {
            "description": "Missing or invalid AB IAM JWT.",
            "schema": {
              "$ref": "#/definitions/handler.errorBody"
            }
          },
          "403": {
            "description": "JWT valid but lacks the required permission, or invalid namespace.",
            "schema": {
              "$ref": "#/definitions/handler.errorBody"
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "List user-authored analytics contexts",
        "tags": [
          "contexts"
        ],
        "x-errorCodes": {},
        "x-security": [
          {
            "iamClientScopes": [
              "analytics"
            ]
          },
          {
            "userPermissions": [
              "ADMIN:NAMESPACE:{namespace}:ANALYTICS:QUERY [READ]"
            ]
          }
        ]
      },
      "post": {
        "consumes": [
          "application/json"
        ],
        "description": "Creates a new user-authored analytics context for the tenant. `order` defaults to `100` when omitted. Calls `mergeCache.Invalidate` so the next `GET /context` returns the updated merge.",
        "operationId": "AdminCreateContext",
        "parameters": [
          {
            "description": "Target namespace.",
            "in": "path",
            "name": "namespace",
            "required": true,
            "type": "string"
          },
          {
            "description": "Context creation request.",
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/handler.contextCreateBody"
            }
          }
        ],
        "produces": [
          "application/json"
        ],
        "responses": {
          "201": {
            "description": "Created context.",
            "schema": {
              "$ref": "#/definitions/handler.contextResponse"
            }
          },
          "400": {
            "description": "Validation error (INVALID_KIND, INVALID_TABLE_REFS, INVALID_ORDER, or bad JSON).",
            "schema": {
              "$ref": "#/definitions/handler.errorBody"
            }
          },
          "401": {
            "description": "Missing or invalid AB IAM JWT.",
            "schema": {
              "$ref": "#/definitions/handler.errorBody"
            }
          },
          "403": {
            "description": "JWT valid but lacks the required permission, or invalid namespace.",
            "schema": {
              "$ref": "#/definitions/handler.errorBody"
            }
          },
          "409": {
            "description": "CONTEXT_NAME_TAKEN or CONTEXT_COUNT_EXCEEDED.",
            "schema": {
              "$ref": "#/definitions/handler.errorBody"
            }
          },
          "413": {
            "description": "CONTEXT_BODY_TOO_LARGE.",
            "schema": {
              "$ref": "#/definitions/handler.errorBody"
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Create a user-authored analytics context",
        "tags": [
          "contexts"
        ],
        "x-errorCodes": {},
        "x-security": [
          {
            "iamClientScopes": [
              "analytics"
            ]
          },
          {
            "userPermissions": [
              "ADMIN:NAMESPACE:{namespace}:ANALYTICS:QUERY [UPDATE]"
            ]
          }
        ]
      }
    },
    "/afs/v1/admin/namespaces/{namespace}/contexts/{id}": {
      "delete": {
        "description": "Deletes a context. Idempotent — deleting an unknown ID returns `204`. Calls `mergeCache.Invalidate` so the next `GET /context` returns the updated merge.",
        "operationId": "AdminDeleteContext",
        "parameters": [
          {
            "description": "Target namespace.",
            "in": "path",
            "name": "namespace",
            "required": true,
            "type": "string"
          },
          {
            "description": "Context ID (KSUID).",
            "in": "path",
            "name": "id",
            "required": true,
            "type": "string"
          }
        ],
        "produces": [
          "application/json"
        ],
        "responses": {
          "204": {
            "description": "Deleted (or already absent)."
          },
          "401": {
            "description": "Missing or invalid AB IAM JWT.",
            "schema": {
              "$ref": "#/definitions/handler.errorBody"
            }
          },
          "403": {
            "description": "JWT valid but lacks the required permission, or invalid namespace.",
            "schema": {
              "$ref": "#/definitions/handler.errorBody"
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Delete a user-authored analytics context",
        "tags": [
          "contexts"
        ],
        "x-errorCodes": {},
        "x-security": [
          {
            "iamClientScopes": [
              "analytics"
            ]
          },
          {
            "userPermissions": [
              "ADMIN:NAMESPACE:{namespace}:ANALYTICS:QUERY [UPDATE]"
            ]
          }
        ]
      },
      "get": {
        "description": "Returns the full context row including `body` and `order`. Returns `404 CONTEXT_NOT_FOUND` for any ID that doesn&#39;t exist in this tenant&#39;s set.",
        "operationId": "AdminGetContextByID",
        "parameters": [
          {
            "description": "Target namespace.",
            "in": "path",
            "name": "namespace",
            "required": true,
            "type": "string"
          },
          {
            "description": "Context ID (KSUID).",
            "in": "path",
            "name": "id",
            "required": true,
            "type": "string"
          }
        ],
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "Full context row.",
            "schema": {
              "$ref": "#/definitions/handler.contextResponse"
            }
          },
          "401": {
            "description": "Missing or invalid AB IAM JWT.",
            "schema": {
              "$ref": "#/definitions/handler.errorBody"
            }
          },
          "403": {
            "description": "JWT valid but lacks the required permission, or invalid namespace.",
            "schema": {
              "$ref": "#/definitions/handler.errorBody"
            }
          },
          "404": {
            "description": "CONTEXT_NOT_FOUND.",
            "schema": {
              "$ref": "#/definitions/handler.errorBody"
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Get a single user-authored analytics context",
        "tags": [
          "contexts"
        ],
        "x-errorCodes": {},
        "x-security": [
          {
            "iamClientScopes": [
              "analytics"
            ]
          },
          {
            "userPermissions": [
              "ADMIN:NAMESPACE:{namespace}:ANALYTICS:QUERY [READ]"
            ]
          }
        ]
      },
      "put": {
        "consumes": [
          "application/json"
        ],
        "description": "Updates `body`, `order`, and/or `table_refs` of an existing context. `name` and `kind` are immutable. Requires `If-Match: &lt;prior updated_at RFC3339&gt;` for optimistic concurrency. Calls `mergeCache.Invalidate` so the next `GET /context` returns the updated merge.",
        "operationId": "AdminUpdateContext",
        "parameters": [
          {
            "description": "Target namespace.",
            "in": "path",
            "name": "namespace",
            "required": true,
            "type": "string"
          },
          {
            "description": "Context ID (KSUID).",
            "in": "path",
            "name": "id",
            "required": true,
            "type": "string"
          },
          {
            "description": "Must match the `updated_at` RFC 3339 value of the last known version.",
            "in": "header",
            "name": "If-Match",
            "required": true,
            "type": "string"
          },
          {
            "description": "Context update request.",
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/handler.contextUpdateBody"
            }
          }
        ],
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "Updated context row.",
            "schema": {
              "$ref": "#/definitions/handler.contextResponse"
            }
          },
          "400": {
            "description": "Validation error or IF_MATCH_REQUIRED.",
            "schema": {
              "$ref": "#/definitions/handler.errorBody"
            }
          },
          "401": {
            "description": "Missing or invalid AB IAM JWT.",
            "schema": {
              "$ref": "#/definitions/handler.errorBody"
            }
          },
          "403": {
            "description": "JWT valid but lacks the required permission, or invalid namespace.",
            "schema": {
              "$ref": "#/definitions/handler.errorBody"
            }
          },
          "404": {
            "description": "CONTEXT_NOT_FOUND.",
            "schema": {
              "$ref": "#/definitions/handler.errorBody"
            }
          },
          "412": {
            "description": "IF_MATCH_FAILED (concurrent update detected).",
            "schema": {
              "$ref": "#/definitions/handler.errorBody"
            }
          },
          "413": {
            "description": "CONTEXT_BODY_TOO_LARGE.",
            "schema": {
              "$ref": "#/definitions/handler.errorBody"
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Update a user-authored analytics context",
        "tags": [
          "contexts"
        ],
        "x-errorCodes": {},
        "x-security": [
          {
            "iamClientScopes": [
              "analytics"
            ]
          },
          {
            "userPermissions": [
              "ADMIN:NAMESPACE:{namespace}:ANALYTICS:QUERY [UPDATE]"
            ]
          }
        ]
      }
    },
    "/afs/v1/admin/namespaces/{namespace}/queries": {
      "post": {
        "consumes": [
          "application/json"
        ],
        "description": "Returns 202 with query_id, or 200 with rows inline if the query terminates within the fast-path window.\nThe `database` field is optional; when omitted, the facade uses the first entry of the configured ALLOWED_DATABASES env var.",
        "operationId": "AdminSubmitQuery",
        "parameters": [
          {
            "description": "Target namespace. Caller must have ADMIN:NAMESPACE:{namespace}:ANALYTICS:QUERY permission.",
            "in": "path",
            "name": "namespace",
            "required": true,
            "type": "string"
          },
          {
            "description": "Optional client-supplied idempotency key used as Athena ClientRequestToken.",
            "in": "header",
            "name": "Idempotency-Key",
            "type": "string"
          },
          {
            "description": "Query request",
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/handler.submitRequest"
            }
          }
        ],
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "Fast-path success: query reached a terminal state within wait_ms.",
            "schema": {
              "$ref": "#/definitions/handler.fetchResponse"
            }
          },
          "202": {
            "description": "Query submitted; poll GET .../queries/{id} for status.",
            "schema": {
              "$ref": "#/definitions/handler.submitAccepted"
            }
          },
          "400": {
            "description": "Bad request (invalid SQL, unknown database, malformed body, missing partition predicate).",
            "schema": {
              "$ref": "#/definitions/handler.errorBody"
            }
          },
          "401": {
            "description": "Missing or invalid AB IAM JWT.",
            "schema": {
              "$ref": "#/definitions/handler.errorBody"
            }
          },
          "403": {
            "description": "JWT valid but lacks the required permission, or invalid namespace.",
            "schema": {
              "$ref": "#/definitions/handler.errorBody"
            }
          },
          "413": {
            "description": "SQL body exceeds the configured MAX_SQL_BYTES limit.",
            "schema": {
              "$ref": "#/definitions/handler.errorBody"
            }
          },
          "429": {
            "description": "Quota exceeded for the current billing period.",
            "schema": {
              "$ref": "#/definitions/handler.errorBody"
            }
          },
          "500": {
            "description": "Unexpected error.",
            "schema": {
              "$ref": "#/definitions/handler.errorBody"
            }
          },
          "503": {
            "description": "Transient tenancy provisioning failure; retry.",
            "schema": {
              "$ref": "#/definitions/handler.errorBody"
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Submit an Athena SQL query (async)",
        "tags": [
          "queries"
        ],
        "x-errorCodes": {},
        "x-security": [
          {
            "iamClientScopes": [
              "analytics"
            ]
          },
          {
            "userPermissions": [
              "ADMIN:NAMESPACE:{namespace}:ANALYTICS:QUERY [READ]"
            ]
          }
        ]
      }
    },
    "/afs/v1/admin/namespaces/{namespace}/queries/{id}": {
      "delete": {
        "operationId": "AdminCancelQuery",
        "parameters": [
          {
            "description": "Target namespace.",
            "in": "path",
            "name": "namespace",
            "required": true,
            "type": "string"
          },
          {
            "description": "The query_id to cancel.",
            "in": "path",
            "name": "id",
            "required": true,
            "type": "string"
          }
        ],
        "produces": [
          "application/json"
        ],
        "responses": {
          "204": {
            "description": "Cancellation issued, or query already terminal."
          },
          "401": {
            "description": "Missing or invalid AB IAM JWT.",
            "schema": {
              "$ref": "#/definitions/handler.errorBody"
            }
          },
          "403": {
            "description": "JWT valid but lacks permission, or caller is not the submitting tenant.",
            "schema": {
              "$ref": "#/definitions/handler.errorBody"
            }
          },
          "404": {
            "description": "Unknown query_id.",
            "schema": {
              "$ref": "#/definitions/handler.errorBody"
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Cancel an in-flight query (idempotent)",
        "tags": [
          "queries"
        ],
        "x-errorCodes": {},
        "x-security": [
          {
            "iamClientScopes": [
              "analytics"
            ]
          },
          {
            "userPermissions": [
              "ADMIN:NAMESPACE:{namespace}:ANALYTICS:QUERY [READ]"
            ]
          }
        ]
      },
      "get": {
        "operationId": "AdminFetchQuery",
        "parameters": [
          {
            "description": "Target namespace.",
            "in": "path",
            "name": "namespace",
            "required": true,
            "type": "string"
          },
          {
            "description": "The query_id returned by POST .../queries.",
            "in": "path",
            "name": "id",
            "required": true,
            "type": "string"
          },
          {
            "description": "Max rows to return (1–10000, default 1000).",
            "in": "query",
            "name": "max_rows",
            "type": "integer"
          },
          {
            "description": "Opaque continuation token from a previous response's next_page_token.",
            "in": "query",
            "name": "page_token",
            "type": "string"
          }
        ],
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "Current state of the query. May still be RUNNING.",
            "schema": {
              "$ref": "#/definitions/handler.fetchResponse"
            }
          },
          "401": {
            "description": "Missing or invalid AB IAM JWT.",
            "schema": {
              "$ref": "#/definitions/handler.errorBody"
            }
          },
          "403": {
            "description": "JWT valid but lacks permission, or caller is not the submitting tenant.",
            "schema": {
              "$ref": "#/definitions/handler.errorBody"
            }
          },
          "404": {
            "description": "Unknown or aged-out query_id.",
            "schema": {
              "$ref": "#/definitions/handler.errorBody"
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Fetch query status and (if terminal) result rows",
        "tags": [
          "queries"
        ],
        "x-errorCodes": {},
        "x-security": [
          {
            "iamClientScopes": [
              "analytics"
            ]
          },
          {
            "userPermissions": [
              "ADMIN:NAMESPACE:{namespace}:ANALYTICS:QUERY [READ]"
            ]
          }
        ]
      }
    },
