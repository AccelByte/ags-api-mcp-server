  "swagger": "2.0",
  "paths": {
    "/observability-manager/v1/admin/namespace/{namespace}/grafana/token/broker": {
      "post": {
        "consumes": [
          "application/json"
        ],
        "description": "Required permission : &lt;code&gt;NAMESPACE:{namespace}:USER:* [READ]&lt;/code&gt;\nMint a short-lived Viewer Grafana service-account token for a dedicated\n(private-cloud) tenant so the AGS AI assistant can query that tenant&#39;s\nGrafana. The token is short-lived and Viewer-only; it is returned once in\nthe success body and never logged. Shared-cloud / Multena tenants are out\nof scope and rejected. The requesting identity (actor) is taken from the\naccess token. The tenant is the {namespace} path parameter the caller is\nauthorized for — there is no request body.\n\nNeed valid access token\n",
        "operationId": "BrokerGrafanaTokenV1",
        "parameters": [
          {
            "description": "game namespace to broker a token for (this is the tenant)",
            "in": "path",
            "name": "namespace",
            "required": true,
            "type": "string"
          }
        ],
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/model.BrokerTokenResult"
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/response.ErrorResponse"
            }
          },
          "401": {
            "description": "Unauthorized",
            "schema": {
              "$ref": "#/definitions/response.ErrorResponse"
            }
          },
          "403": {
            "description": "Forbidden",
            "schema": {
              "$ref": "#/definitions/response.ErrorResponse"
            }
          },
          "500": {
            "description": "Internal Server Error",
            "schema": {
              "$ref": "#/definitions/response.ErrorResponse"
            }
          }
        },
        "security": [
          {
            "authorization": []
          }
        ],
        "summary": "Broker a short-lived Viewer Grafana service-account token for a dedicated tenant (ADR-0024)",
        "tags": [
          "Grafana Access"
        ],
        "x-errorCodes": {}
      }
    }
  },
